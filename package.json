{
  "name": "@nextbrowser-oss/x-monitoring",
  "version": "0.1.0",
  "private": true,
  "description": "Watches an X account through a NextBrowser profile: new posts from the accounts it follows, and follower-count changes.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "bin": {
    "x-monitor": "dist/node/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.9"
  }
}
